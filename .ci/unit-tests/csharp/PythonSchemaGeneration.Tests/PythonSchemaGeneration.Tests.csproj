<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="..\..\..\BHoMReferences.props" />

  <PropertyGroup>
    <CSharpSchemaTestRoot Condition="'$(CSharpSchemaTestRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', '..', '..', '..', 'CSharpSchema_Test'))</CSharpSchemaTestRoot>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\generation\PythonSchemaGeneration.Core\PythonSchemaGeneration.Core.csproj" />
    <ProjectReference Include="..\..\..\generation\PythonSchemaGeneration.Patcher\PythonSchemaGeneration.Patcher.csproj" />
    <ProjectReference Include="$(CSharpSchemaTestRoot)FixtureAlpha_oM\FixtureAlpha_oM.csproj" AdditionalProperties="SkipAssemblyCopy=true" />
    <ProjectReference Include="$(CSharpSchemaTestRoot)FixtureBeta_oM\FixtureBeta_oM.csproj" AdditionalProperties="SkipAssemblyCopy=true" />
  </ItemGroup>

  <!-- The test classes live in the CSharpSchema_Test repository, cloned next to this one (or pass -p:CSharpSchemaTestRoot=<folder>) -->
  <Target Name="CheckCSharpSchemaTest" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(CSharpSchemaTestRoot)FixtureAlpha_oM\FixtureAlpha_oM.csproj')" Text="CSharpSchema_Test was not found at $(CSharpSchemaTestRoot). Clone https://github.com/BHoM/CSharpSchema_Test next to this repository, or pass -p:CSharpSchemaTestRoot=&lt;folder&gt;." />
  </Target>

</Project>
